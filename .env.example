VITE_API_URL=http://localhost:3001
VITE_GEMINI_API_KEY=your_key_here
VITE_OPENAI_API_KEY=your_key_here
VITE_OPENWEATHER_API_KEY=your_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Express server only (server/.env). Never prefix these with VITE_.
# Obtain from app.liveavatar.com, not the legacy HeyGen API dashboard.
AVATAR_API_KEY=
AVATAR_ID=
AVATAR_VOICE_ID=
# Keep sandbox enabled for initial testing; false uses paid credits.
AVATAR_SANDBOX=true
